<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Materia Flow Lab — EV Battery Raw Material Tree Simulator</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500;700&family=Fraunces:ital,opsz,wght@1,9..144,500;1,9..144,700&family=Noto+Sans+KR:wght@400;500;700;800&display=swap');
:root{
  --bg:#070b12;--bg2:#0b111d;--panel:#111a2a;--panel2:#152033;--line:#26364f;--line2:#354867;
  --text:#edf4ff;--sub:#9eacc4;--muted:#65748f;--cyan:#20d9f0;--cyan2:#72f2ff;--gold:#f2b84b;--red:#ff5c8a;--green:#42d392;--purple:#9b6cff;
  --mono:'DM Mono',monospace;--ser:'Fraunces',serif;--sans:'Noto Sans KR',system-ui,sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0} html,body{height:100%}
body{background:radial-gradient(circle at 65% 0%,rgba(32,217,240,.10),transparent 42%),var(--bg);color:var(--text);font-family:var(--sans);overflow:hidden}
.header{height:96px;padding:18px 22px 12px;border-bottom:1px solid var(--line);background:rgba(7,11,18,.88);backdrop-filter:blur(10px);display:flex;align-items:flex-start;gap:18px}
.brand{font-family:var(--ser);font-size:20px;color:var(--cyan);font-style:italic;white-space:nowrap;line-height:1.1}
.titlebox{min-width:0}.title{font-size:28px;font-weight:800;letter-spacing:-.04em}.desc{font-size:13px;color:var(--sub);line-height:1.55;margin-top:6px;max-width:1050px}
.pills{margin-left:auto;display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}.pill{font-family:var(--mono);font-size:10px;padding:7px 10px;border-radius:999px;border:1px solid var(--line2);color:var(--sub);background:rgba(17,26,42,.8)}.pill.on{color:#071018;background:var(--cyan);border-color:var(--cyan)}
.app{display:grid;grid-template-columns:360px 1fr 380px;height:calc(100% - 96px)}
.side,.right{background:rgba(11,17,29,.86);border-right:1px solid var(--line);overflow:auto}.right{border-right:none;border-left:1px solid var(--line)}
.side-inner,.right-inner{padding:18px}.metric-row{display:grid;grid-template-columns:1fr 1fr;gap:10px}.metric{background:linear-gradient(180deg,rgba(21,32,51,.95),rgba(13,21,34,.95));border:1px solid var(--line);border-radius:14px;padding:14px}.ml{font-family:var(--mono);font-size:10px;color:var(--muted);margin-bottom:6px}.mv{font-family:var(--ser);font-size:26px;color:#fff;font-style:italic}.ms{font-size:11px;color:var(--sub);margin-top:2px}
.section{margin-top:16px;padding-top:15px;border-top:1px dashed var(--line)}.st{font-family:var(--mono);font-size:11px;letter-spacing:.08em;color:var(--muted);text-transform:uppercase;margin-bottom:10px}.legend{display:flex;flex-direction:column;gap:9px}.leg{display:grid;grid-template-columns:10px 1fr auto;gap:9px;align-items:center;font-size:12px;color:var(--sub)}.dot{width:10px;height:10px;border-radius:50%}.pct{font-family:var(--mono);color:var(--text)}
.slider-card{background:rgba(17,26,42,.7);border:1px solid var(--line);border-radius:14px;padding:12px;margin-bottom:9px}.slider-top{display:flex;align-items:center;gap:8px;margin-bottom:8px}.slider-name{font-weight:800;font-size:13px;flex:1}.slider-val{font-family:var(--mono);font-size:12px;color:var(--cyan)}input[type=range]{width:100%;accent-color:var(--cyan)}.tiny{font-size:11px;color:var(--muted);line-height:1.55}.btns{display:flex;gap:8px;flex-wrap:wrap}.btn{border:1px solid var(--line2);background:rgba(17,26,42,.95);color:var(--sub);border-radius:10px;padding:9px 10px;font-size:12px;font-weight:700;cursor:pointer}.btn:hover{color:var(--cyan);border-color:rgba(32,217,240,.5)}
.canvas-wrap{position:relative;overflow:auto;background:linear-gradient(90deg,rgba(255,255,255,.02) 1px,transparent 1px),linear-gradient(rgba(255,255,255,.02) 1px,transparent 1px);background-size:36px 36px}.canvas{position:relative;width:1780px;height:980px}.svg{position:absolute;inset:0;width:1780px;height:980px;pointer-events:none}.edge{fill:none;stroke:rgba(32,217,240,.35);stroke-width:2;stroke-dasharray:8 8;animation:dash 12s linear infinite}.edge.strong{stroke:var(--cyan);stroke-width:5;filter:drop-shadow(0 0 8px rgba(32,217,240,.7));stroke-dasharray:0}.edge.dim{stroke:rgba(100,116,139,.12);stroke-width:1.5}@keyframes dash{to{stroke-dashoffset:-120}}
.node{position:absolute;width:218px;min-height:68px;border-radius:16px;border:1px solid var(--line2);background:rgba(14,22,36,.96);padding:12px 14px;box-shadow:0 18px 35px rgba(0,0,0,.25);cursor:pointer;transition:.16s transform,.16s border,.16s box-shadow}.node:hover{transform:translateY(-2px);border-color:var(--cyan);box-shadow:0 0 0 1px rgba(32,217,240,.25),0 18px 45px rgba(0,0,0,.35)}.node.active{border-color:var(--cyan);box-shadow:0 0 0 2px rgba(32,217,240,.25),0 0 25px rgba(32,217,240,.25)}.node.dim{opacity:.28}.node .n-title{font-size:14px;font-weight:800;letter-spacing:-.01em}.node .n-cost{font-family:var(--mono);font-size:12px;color:var(--cyan);margin-top:6px}.node .n-type{font-family:var(--mono);font-size:9px;color:var(--muted);text-transform:uppercase;margin-top:5px}.node .impact{position:absolute;right:10px;top:10px;font-family:var(--mono);font-size:10px;padding:2px 6px;border-radius:999px;background:rgba(32,217,240,.1);color:var(--cyan)}.node.high{border-color:rgba(255,92,138,.45)}.node.high .impact{background:rgba(255,92,138,.13);color:var(--red)}.node.med{border-color:rgba(242,184,75,.45)}.node.med .impact{background:rgba(242,184,75,.12);color:var(--gold)}.node.low{border-color:rgba(66,211,146,.35)}.node.low .impact{background:rgba(66,211,146,.12);color:var(--green)}
.col-label{position:absolute;top:24px;font-family:var(--mono);font-size:11px;color:var(--muted);letter-spacing:.16em;text-transform:uppercase}.lane{position:absolute;left:30px;right:30px;height:1px;border-top:1px dashed rgba(53,72,103,.55)}.lane-label{position:absolute;left:30px;font-family:var(--mono);font-size:10px;color:var(--muted);background:rgba(7,11,18,.85);padding:3px 7px;border-radius:999px;border:1px solid var(--line)}
.detail-title{font-size:22px;font-weight:800;letter-spacing:-.03em;margin-bottom:8px}.detail-sub{font-family:var(--mono);font-size:11px;color:var(--muted);margin-bottom:14px}.info-card{background:rgba(17,26,42,.72);border:1px solid var(--line);border-radius:14px;padding:13px;margin-bottom:10px}.info-k{font-family:var(--mono);font-size:10px;color:var(--muted);margin-bottom:5px}.info-v{font-size:13px;color:var(--sub);line-height:1.7}.risk-badge{display:inline-block;font-family:var(--mono);font-size:10px;border-radius:999px;padding:4px 8px;border:1px solid var(--line2);margin-right:5px}.risk-high{color:var(--red);border-color:rgba(255,92,138,.5);background:rgba(255,92,138,.1)}.risk-med{color:var(--gold);border-color:rgba(242,184,75,.5);background:rgba(242,184,75,.1)}.risk-low{color:var(--green);border-color:rgba(66,211,146,.5);background:rgba(66,211,146,.1)}
.table{width:100%;border-collapse:collapse;font-size:12px}.table th,.table td{padding:8px;border-bottom:1px solid var(--line);text-align:left}.table th{font-family:var(--mono);font-size:10px;color:var(--muted)}.table td:last-child{text-align:right;font-family:var(--mono);color:var(--cyan)}
.note{font-size:11px;color:var(--muted);line-height:1.6;margin-top:12px}.warning{color:var(--gold)}
@media(max-width:1100px){body{overflow:auto}.header{height:auto}.app{display:block;height:auto}.side,.right{height:auto}.canvas-wrap{height:760px}.canvas,.svg{width:1500px}.right{border-left:none;border-top:1px solid var(--line)}}
</style>
</head>
<body>
<header class="header">
  <div class="brand">Materia Flow Lab</div>
  <div class="titlebox">
    <div class="title">EV 배터리 원자재 트리 & 가격 충격 시뮬레이터</div>
    <div class="desc">배터리 팩을 Cell · Electrical · Thermal · Structure · Assembly로 나누고, 소재와 원자재 흐름을 연결합니다. 슬라이더로 원자재 가격 충격을 주면 제품 비용 영향이 즉시 반영됩니다.</div>
  </div>
  <div class="pills"><span class="pill on">Interactive</span><span class="pill">Raw Material Tree</span><span class="pill">Scenario</span></div>
</header>
<main class="app">
  <aside class="side"><div class="side-inner">
    <div class="metric-row">
      <div class="metric"><div class="ml">Base Pack Cost</div><div class="mv" id="baseCost">$10,900</div><div class="ms">illustrative BEV pack</div></div>
      <div class="metric"><div class="ml">Scenario Cost</div><div class="mv" id="scenarioCost">$10,900</div><div class="ms" id="scenarioDelta">+0.0%</div></div>
    </div>
    <div class="section">
      <div class="st">Cost Family</div>
      <div class="legend" id="familyLegend"></div>
    </div>
    <div class="section">
      <div class="st">Scenario Presets</div>
      <div class="btns">
        <button class="btn" onclick="preset('reset')">Reset</button>
        <button class="btn" onclick="preset('lithium')">Lithium Shock</button>
        <button class="btn" onclick="preset('metals')">Metal Inflation</button>
        <button class="btn" onclick="preset('energy')">Energy Shock</button>
        <button class="btn" onclick="preset('supply')">Supply Stress</button>
      </div>
    </div>
    <div class="section">
      <div class="st">Raw Material Shock</div>
      <div id="sliders"></div>
      <p class="note">* 가격 영향은 학습용 가정치입니다. 실제 분석은 셀 화학계, 팩 용량, 수율, 계약 가격, 지역별 전력 믹스에 따라 달라집니다.</p>
    </div>
  </div></aside>
  <section class="canvas-wrap" id="wrap"><div class="canvas" id="canvas">
    <svg class="svg" id="svg"><defs><filter id="glow"><feGaussianBlur stdDeviation="3" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter></defs></svg>
    <div class="col-label" style="left:70px">Product</div><div class="col-label" style="left:385px">System / Family</div><div class="col-label" style="left:705px">Material / Part</div><div class="col-label" style="left:1060px">Processed Material</div><div class="col-label" style="left:1405px">Raw Material</div>
  </div></section>
  <aside class="right"><div class="right-inner">
    <div class="detail-title" id="detailTitle">Battery Pack</div>
    <div class="detail-sub" id="detailSub">PRODUCT NODE</div>
    <div class="info-card"><div class="info-k">설명</div><div class="info-v" id="detailDesc">노드를 클릭하면 해당 흐름과 가격 민감도가 강조됩니다.</div></div>
    <div class="info-card"><div class="info-k">리스크</div><div class="info-v" id="detailRisk"><span class="risk-badge risk-med">medium</span>학습용 리스크 분류</div></div>
    <div class="info-card"><div class="info-k">가격 충격 영향</div><div class="info-v" id="detailImpact">현재 선택된 노드 없음</div></div>
    <div class="section"><div class="st">Top Impact Drivers</div><table class="table" id="impactTable"><thead><tr><th>원자재</th><th>충격</th><th>영향</th></tr></thead><tbody></tbody></table></div>
    <p class="note warning">자료 근거: EV 배터리는 cell → module → pack 구조이며, 셀 원재료·생산이 배터리 비용의 큰 비중을 차지합니다. 업로드 PDF와 공개 산업 지식을 바탕으로 만든 프로토타입입니다.</p>
  </div></aside>
</main>
<script>
const BASE=10900;
const colors={cell:'#20d9f0',electrical:'#9b6cff',thermal:'#42d392',structure:'#f2b84b',assembly:'#ff5c8a',commodity:'#72f2ff'};
const families=[
 {id:'cell',name:'Cell / Electrochemistry',cost:6540,color:colors.cell},
 {id:'electrical',name:'Electrical / Control',cost:1180,color:colors.electrical},
 {id:'thermal',name:'Thermal System',cost:760,color:colors.thermal},
 {id:'structure',name:'Structure / Housing',cost:1420,color:colors.structure},
 {id:'assembly',name:'Assembly / Process',cost:1000,color:colors.assembly}
];
const nodes=[
 {id:'pack',title:'EV Battery Pack',type:'product',x:70,y:460,w:230,cost:BASE,risk:'med',desc:'Cell, electrical, thermal, structure, assembly가 결합된 고전압 배터리 팩.'},
 ...families.map((f,i)=>({id:f.id,title:f.name,type:'family',x:370,y:130+i*160,w:250,cost:f.cost,color:f.color,risk:i===0?'high':'med',desc:'배터리 팩 비용과 리스크를 구성하는 상위 시스템 그룹.'})),
 {id:'cathode',title:'Cathode active material',type:'material',x:705,y:92,cost:3050,color:colors.cell,risk:'high',desc:'NCM/NCA/LFP 등 양극 활물질. 리튬·니켈·코발트·망간/철 가격에 민감.'},
 {id:'anode',title:'Anode / graphite',type:'material',x:705,y:182,cost:820,color:colors.cell,risk:'med',desc:'천연/인조 흑연 및 실리콘 첨가재. 인조흑연은 에너지 비용 영향이 큼.'},
 {id:'electrolyte',title:'Electrolyte / LiPF₆',type:'material',x:705,y:272,cost:610,color:colors.cell,risk:'high',desc:'LiPF6 염과 carbonate solvent 조합. 불소화학·리튬 원료 의존.'},
 {id:'separator',title:'Separator film',type:'material',x:705,y:362,cost:520,color:colors.cell,risk:'med',desc:'PE/PP 미세다공막. 안전성과 수율에 중요.'},
 {id:'busbar',title:'Busbar / HV cable',type:'material',x:705,y:492,cost:520,color:colors.electrical,risk:'med',desc:'구리·알루미늄 도체 기반 전기 연결.'},
 {id:'bms',title:'BMS / BECM / sensors',type:'material',x:705,y:582,cost:660,color:colors.electrical,risk:'med',desc:'배터리 관리 제어기, 센서, 커넥터, PCB.'},
 {id:'cooling',title:'Cooling plate / coolant',type:'material',x:705,y:690,cost:760,color:colors.thermal,risk:'med',desc:'냉각판, 냉각수, 열전달재. 열폭주와 수명 관리 핵심.'},
 {id:'tray',title:'Tray / cover / brackets',type:'material',x:705,y:798,cost:1420,color:colors.structure,risk:'med',desc:'팩 하우징, 커버, 브라켓. 알루미늄·강재 비중 큼.'},
 {id:'fastener',title:'Fasteners / adhesive',type:'material',x:705,y:890,cost:1000,color:colors.assembly,risk:'low',desc:'볼트·너트·접착·용접·실링 공정.'},
 {id:'lithiumChem',title:'Lithium carbonate / hydroxide',type:'processed',x:1045,y:92,cost:1320,risk:'high',desc:'리튬 광석/염호에서 정제된 배터리급 리튬 화합물.'},
 {id:'nickelChem',title:'Nickel sulfate',type:'processed',x:1045,y:170,cost:760,risk:'high',desc:'고니켈 양극재의 핵심 전구체.'},
 {id:'cobaltChem',title:'Cobalt sulfate',type:'processed',x:1045,y:248,cost:360,risk:'high',desc:'NCM/NCA 양극재 안정화 원료. 윤리·지역 리스크가 큼.'},
 {id:'manganeseChem',title:'Manganese / iron phosphate',type:'processed',x:1045,y:326,cost:230,risk:'med',desc:'NCM의 Mn 또는 LFP의 Fe/P 계열 원료.'},
 {id:'graphiteProc',title:'Spherical / synthetic graphite',type:'processed',x:1045,y:432,cost:820,risk:'med',desc:'음극용 구상흑연 또는 인조흑연.'},
 {id:'fluoro',title:'LiPF₆ / fluorochemicals',type:'processed',x:1045,y:520,cost:370,risk:'high',desc:'전해질 염 및 불소화학 밸류체인.'},
 {id:'solvents',title:'Carbonate solvents',type:'processed',x:1045,y:598,cost:240,risk:'med',desc:'EC, DMC, EMC 등 석유화학 기반 용매.'},
 {id:'polyolefin',title:'PE / PP film',type:'processed',x:1045,y:676,cost:520,risk:'med',desc:'분리막용 폴리올레핀 필름.'},
 {id:'copperProc',title:'Copper foil / wire',type:'processed',x:1045,y:766,cost:620,risk:'med',desc:'음극 집전체, 버스바, 케이블 원료.'},
 {id:'alSteel',title:'Aluminum / steel products',type:'processed',x:1045,y:856,cost:1670,risk:'med',desc:'트레이, 커버, 브라켓, 냉각판, 구조재.'},
 {id:'electronics',title:'PCB / semiconductor / sensor',type:'processed',x:1045,y:936,cost:660,risk:'med',desc:'BMS 전자부품과 센서류.'},
 {id:'liOre',title:'Lithium brine / spodumene',type:'raw',x:1395,y:86,cost:1320,shock:'lithium',risk:'high',desc:'리튬 염호 또는 스포듀민 광석.'},
 {id:'niOre',title:'Nickel ore',type:'raw',x:1395,y:164,cost:760,shock:'nickel',risk:'high',desc:'황화광/라테라이트 니켈 원광.'},
 {id:'coOre',title:'Cobalt ore',type:'raw',x:1395,y:242,cost:360,shock:'cobalt',risk:'high',desc:'코발트 원광. 공급 집중과 윤리 리스크가 큼.'},
 {id:'mnFe',title:'Manganese / iron / phosphate',type:'raw',x:1395,y:320,cost:230,shock:'manganese',risk:'med',desc:'망간, 철, 인산염 계열 원료.'},
 {id:'graphiteRaw',title:'Natural graphite / petroleum coke',type:'raw',x:1395,y:430,cost:820,shock:'graphite',risk:'med',desc:'천연흑연 또는 인조흑연용 petroleum coke.'},
 {id:'fluorine',title:'Fluorspar / phosphorus',type:'raw',x:1395,y:520,cost:370,shock:'fluorine',risk:'high',desc:'불소화학 및 LiPF6 원료.'},
 {id:'oilGas',title:'Crude oil / gas / petrochemical feedstock',type:'raw',x:1395,y:604,cost:760,shock:'oil',risk:'med',desc:'전해액 용매, 분리막, 플라스틱, 접착제의 상류 원료.'},
