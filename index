 {id:'bauxiteIron',title:'Bauxite / iron ore',type:'raw',x:1395,y:842,cost:1670,shock:'aluminum',risk:'med',desc:'알루미늄과 강재의 상류 원료.'},
 {id:'siliconRare',title:'Silicon / rare metals / chips',type:'raw',x:1395,y:930,cost:660,shock:'semis',risk:'med',desc:'BMS 반도체·센서 공급망.'}
];
const links=[
 ['pack','cell'],['pack','electrical'],['pack','thermal'],['pack','structure'],['pack','assembly'],
 ['cell','cathode'],['cell','anode'],['cell','electrolyte'],['cell','separator'],
 ['electrical','busbar'],['electrical','bms'],['thermal','cooling'],['structure','tray'],['assembly','fastener'],
 ['cathode','lithiumChem'],['cathode','nickelChem'],['cathode','cobaltChem'],['cathode','manganeseChem'],['anode','graphiteProc'],['electrolyte','fluoro'],['electrolyte','solvents'],['separator','polyolefin'],['busbar','copperProc'],['bms','electronics'],['cooling','alSteel'],['cooling','solvents'],['tray','alSteel'],['fastener','alSteel'],['fastener','solvents'],
 ['lithiumChem','liOre'],['nickelChem','niOre'],['cobaltChem','coOre'],['manganeseChem','mnFe'],['graphiteProc','graphiteRaw'],['fluoro','fluorine'],['solvents','oilGas'],['polyolefin','oilGas'],['copperProc','copperOre'],['alSteel','bauxiteIron'],['electronics','siliconRare']
];
const shocks={lithium:{name:'Lithium',v:0},nickel:{name:'Nickel',v:0},cobalt:{name:'Cobalt',v:0},manganese:{name:'Mn/Fe/P',v:0},graphite:{name:'Graphite',v:0},fluorine:{name:'Fluorochem.',v:0},oil:{name:'Oil/Petrochem.',v:0},copper:{name:'Copper',v:0},aluminum:{name:'Al/Steel',v:0},semis:{name:'Semiconductor',v:0}};
const pass={};
function buildPass(){Object.keys(pass).forEach(k=>delete pass[k]);links.forEach(([a,b])=>{(pass[b]??=[]).push(a)});} buildPass();
const nodeMap=Object.fromEntries(nodes.map(n=>[n.id,n]));
function upstream(id,set=new Set()){set.add(id);(pass[id]||[]).forEach(p=>upstream(p,set));return set}
function downstream(id,set=new Set()){set.add(id);links.filter(l=>l[0]===id).forEach(l=>downstream(l[1],set));return set}
function riskClass(r){return r==='high'?'high':r==='low'?'low':'med'}
function fmt(v){return '$'+Math.round(v).toLocaleString()}
function scenarioImpact(){let total=BASE;nodes.filter(n=>n.type==='raw').forEach(n=>{total+=n.cost*((shocks[n.shock]?.v||0)/100)});return total}
function rawImpact(n){return n.cost*((shocks[n.shock]?.v||0)/100)}
function render(){
 const c=document.getElementById('canvas'); [...c.querySelectorAll('.node,.lane,.lane-label')].forEach(e=>e.remove());
 [118,418,648,780,878].forEach((y,i)=>{const l=document.createElement('div');l.className='lane';l.style.top=(y-30)+'px';c.appendChild(l); const la=document.createElement('div');la.className='lane-label';la.style.top=(y-43)+'px';la.textContent=['CELL MATERIALS','ELECTRICAL','THERMAL','STRUCTURE','ASSEMBLY'][i];c.appendChild(la);});
 nodes.forEach(n=>{const el=document.createElement('div');el.className='node '+riskClass(n.risk);el.id='node-'+n.id;el.style.left=n.x+'px';el.style.top=n.y+'px';el.style.width=(n.w||218)+'px'; if(n.color) el.style.borderColor=n.color+'88'; let cost=n.cost; if(n.type==='raw') cost=n.cost*(1+(shocks[n.shock]?.v||0)/100); el.innerHTML=`<div class="impact">${n.risk}</div><div class="n-title">${n.title}</div><div class="n-cost">${fmt(cost)}</div><div class="n-type">${n.type}</div>`; el.onclick=()=>selectNode(n.id); c.appendChild(el);});
 drawEdges(); updateMetrics(); updateImpactTable();
}
function center(n){return {x:n.x+(n.w||218)/2,y:n.y+34}}
function drawEdges(activeSet=null){const svg=document.getElementById('svg');svg.innerHTML='<defs><filter id="glow"><feGaussianBlur stdDeviation="3" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter></defs>';links.forEach((l,i)=>{const a=nodeMap[l[0]],b=nodeMap[l[1]],pa=center(a),pb=center(b);const sx=a.x+(a.w||218),sy=pa.y,ex=b.x,ey=pb.y;const mid=(sx+ex)/2;const path=document.createElementNS('http://www.w3.org/2000/svg','path');path.setAttribute('d',`M ${sx} ${sy} C ${mid} ${sy}, ${mid} ${ey}, ${ex} ${ey}`);const strong=activeSet && activeSet.has(l[0]) && activeSet.has(l[1]);path.setAttribute('class','edge '+(activeSet?(strong?'strong':'dim'):''));svg.appendChild(path);});}
function updateMetrics(){const total=scenarioImpact();document.getElementById('baseCost').textContent=fmt(BASE);document.getElementById('scenarioCost').textContent=fmt(total);const d=(total/BASE-1)*100;document.getElementById('scenarioDelta').textContent=(d>=0?'+':'')+d.toFixed(1)+'%';}
function renderLegend(){const box=document.getElementById('familyLegend');box.innerHTML='';families.forEach(f=>{const p=f.cost/BASE*100;box.innerHTML+=`<div class="leg"><span class="dot" style="background:${f.color}"></span><span>${f.name}</span><span class="pct">${p.toFixed(1)}%</span></div>`;});}
function renderSliders(){const s=document.getElementById('sliders');s.innerHTML='';Object.entries(shocks).forEach(([k,o])=>{s.innerHTML+=`<div class="slider-card"><div class="slider-top"><div class="slider-name">${o.name}</div><div class="slider-val" id="val-${k}">+0%</div></div><input type="range" min="-50" max="100" step="5" value="0" oninput="setShock('${k}',this.value)"></div>`;});}
function setShock(k,v){shocks[k].v=Number(v);document.getElementById('val-'+k).textContent=(v>=0?'+':'')+v+'%';render();}
function preset(p){const vals={reset:{},lithium:{lithium:60,nickel:20,cobalt:20},metals:{nickel:35,cobalt:30,copper:25,aluminum:20},energy:{oil:50,graphite:25,aluminum:15},supply:{lithium:50,cobalt:45,fluorine:35,semis:30}};Object.keys(shocks).forEach(k=>{shocks[k].v=vals[p][k]||0;});renderSliders();Object.entries(shocks).forEach(([k,o])=>{const input=[...document.querySelectorAll('input[type=range]')].find(x=>x.getAttribute('oninput').includes(`'${k}'`));if(input)input.value=o.v;document.getElementById('val-'+k).textContent=(o.v>=0?'+':'')+o.v+'%';});render();}
function updateImpactTable(){const tbody=document.querySelector('#impactTable tbody');const rows=nodes.filter(n=>n.type==='raw').map(n=>({n,imp:rawImpact(n)})).sort((a,b)=>Math.abs(b.imp)-Math.abs(a.imp)).slice(0,6);tbody.innerHTML=rows.map(r=>`<tr><td>${r.n.title}</td><td>${(shocks[r.n.shock].v>=0?'+':'')+shocks[r.n.shock].v}%</td><td>${fmt(r.imp)}</td></tr>`).join('');}
function selectNode(id){const n=nodeMap[id];const u=upstream(id);const d=downstream(id);const active=new Set([...u,...d]);document.querySelectorAll('.node').forEach(el=>{const nid=el.id.replace('node-','');el.classList.toggle('active',nid===id);el.classList.toggle('dim',!active.has(nid));});drawEdges(active);document.getElementById('detailTitle').textContent=n.title;document.getElementById('detailSub').textContent=n.type.toUpperCase()+' NODE';document.getElementById('detailDesc').textContent=n.desc;document.getElementById('detailRisk').innerHTML=`<span class="risk-badge risk-${riskClass(n.risk)}">${n.risk}</span>${n.risk==='high'?'공급 집중·가격 변동성·기술 의존도가 큰 영역입니다.':n.risk==='med'?'중간 수준의 가격/공급망 민감도를 갖는 영역입니다.':'대체 또는 범용 조달 가능성이 비교적 높은 영역입니다.'}`;let msg=''; if(n.type==='raw'){msg=`현재 ${shocks[n.shock].name} 충격 ${shocks[n.shock].v}% → 팩 비용 영향 ${fmt(rawImpact(n))}`;} else {const ds=[...d].map(x=>nodeMap[x]).filter(x=>x.type==='raw');const imp=ds.reduce((a,x)=>a+rawImpact(x),0);msg=`이 노드의 하위 원자재 시나리오 영향: ${fmt(imp)}`;}document.getElementById('detailImpact').textContent=msg;}
renderLegend();renderSliders();render();selectNode('pack');
</script>
</body>
</html>
